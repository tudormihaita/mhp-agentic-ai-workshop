# Copy this file to `.env` (same folder) and fill in the values for your provider.
# macOS/Linux:  cp .env.example .env
# Windows:      copy .env.example .env
# NEVER commit your .env file - it contains your personal key.

# Which provider to use: deepseek | bedrock | ollama | gemini
MODEL_PROVIDER=deepseek

# DeepSeek via Deploy (default for the workshop) - see docs/setup-deepseek.md
DEEPSEEK_API_KEY=<paste-your-deploy-api-key-here>
DEEPSEEK_API_BASE=https://api-cdn.thehive.ai/api/v3
DEEPSEEK_MODEL=deepseek-ai/deepseek-v4.1-flash-1017

# Amazon Bedrock (alternative, key from the instructor) - see docs/setup-bedrock.md
AWS_BEARER_TOKEN_BEDROCK=<paste-your-bedrock-api-key-here>
AWS_REGION=eu-west-1
BEDROCK_MODEL=eu.anthropic.claude-sonnet-5-5

# Ollama (optional, local models) - see docs/setup-ollama.md
OLLAMA_MODEL=qwen3:4b
OLLAMA_API_BASE=http://localhost:11434

# Google Gemini (optional) - see docs/setup-gemini.md
GOOGLE_API_KEY=<paste-your-gemini-api-key-here>
GEMINI_MODEL=gemini-3.5-flash
